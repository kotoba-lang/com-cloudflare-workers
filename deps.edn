;; Design record: ADR-2607253500 (superproject 90-docs/adr/).
;;
;; The pure core (command/policy/admission/receipt) is .cljc and runs under
;; both nbb and JVM Clojure -- that dual run IS the parity evidence for the
;; core, and it has already earned its keep: it caught a ClojureScript-only
;; bug where `int` on a non-numeric string coerces to 0, which made every
;; character look like a digit in the SQL placeholder counter. nbb remains the
;; first-class script host (ADR-2607173000); this alias exists so the same
;; .cljc is read and executed by a second, independent runtime.
;;
;; The :test alias deliberately DISCOVERS namespaces rather than listing them.
;; An explicit -n list silently stops covering any test file added later, which
;; would let the parity evidence decay without a single failing run to say so.
;; cognitect test-runner scans .clj/.cljc only, so the workerd-only
;; provider_test.cljs is skipped here by construction, not by enumeration --
;; run it with `npm test`.
{:paths ["src" "resources"]
 :deps {
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text {:git/sha "73bdb13ae7a3d004b44bca08be03a3191157a38f"}
       org.clojure/clojure {:mvn/version "1.11.1"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner" "-d" "test"]
         :exec-fn cognitect.test-runner.api/test}
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}}}
